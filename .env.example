[TEMPLATE]
# Copy this file to .env and edit. Every line is optional.

# Port the site listens on.
PORT=3000

# First-run admin password. Used only the first time the server starts.
# If you leave it empty, a random password is printed in the terminal instead.
# After that, change the password inside /admin (Password tab).
ADMIN_PASSWORD=

# Where the site text, orders and uploaded images are stored.
# Point these at a persistent disk when you deploy. Defaults: ./data and ./uploads
DATA_DIR=
UPLOAD_DIR=

# Set to 1 when the site runs behind a proxy that adds HTTPS (most hosting platforms).
TRUST_PROXY=0

# Razorpay keys, needed to sell artworks. Create them under
# Dashboard > Account & Settings > API keys. Use the test keys first.
# Without these the site still runs; the Buy button reports that payments are not set up.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
